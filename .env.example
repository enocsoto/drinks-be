# Copiar a .env (o usar variables del sistema). No commitear valores reales en producción.

# Auth JWT
JWT_SECRET=change-me-in-production
EXPIRES_IN=7d

# API
APP_PORT=3001

# CORS: orígenes del front (coma-separado). Incluir URL del Next (drinks-fe).
CORS_ORIGINS=http://localhost:3000

# MongoDB: opción 1 — URI completa
# MONGODB_URI=mongodb://localhost:27017/drinks

# MongoDB: opción 2 — host / puerto / nombre (si no hay MONGODB_URI)
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=drinks
